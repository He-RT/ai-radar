# Copy to infra/env/development.env for local development. These values are deliberately
# non-production and may be committed only in this example form.
COMPOSE_PROJECT_NAME=amplitude-radar-dev

CADDY_IMAGE=caddy:2.10.0-alpine@sha256:ae4458638da8e1a91aafffb231c5f8778e964bca650c8a8cb23a7e8ac557aa3c
POSTGRES_IMAGE=pgvector/pgvector:pg18@sha256:691673308c99d2161ba298736f3147f1f22d79de2fb7ec93ae9b4afcab870b62
VALKEY_IMAGE=valkey/valkey:8-alpine@sha256:a038175878d66b9d274fbf8be73c0305e93798b83917647f167e18cef3c71eec
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-04-16T18-13-26Z@sha256:aead63c77f9db9107f1696fb08ecb0faeda23729cde94b0f663edf4fe09728e3
MAILPIT_IMAGE=axllent/mailpit:v1.30.7@sha256:d5ecbb067db3705fa953d79e1b7f81ef84038df67aba6c52825d8c02a1ea748a

POSTGRES_DB=amplitude_radar_dev
# Bootstrap role: only PostgreSQL itself and backup/restore maintenance use this login.
POSTGRES_USER=amplitude
POSTGRES_PASSWORD=dev-only-not-a-secret
POSTGRES_MIGRATION_USER=amplitude_migrate
POSTGRES_MIGRATION_PASSWORD=dev-only-not-a-secret-migrate
POSTGRES_APP_USER=amplitude_app
POSTGRES_APP_PASSWORD=dev-only-not-a-secret-app
VALKEY_PASSWORD=dev-only-not-a-secret
MINIO_ROOT_USER=amplitude-minio
MINIO_ROOT_PASSWORD=dev-only-not-a-secret
MINIO_BUCKET=amplitude-radar-dev
# Application-only MinIO identity. It is restricted to MINIO_BUCKET by minio-init.
RADAR_S3_ACCESS_KEY=radar-dev-app
RADAR_S3_SECRET_KEY=dev-only-not-a-secret-s3

RADAR_APP_SECRET_KEY=dev-only-not-a-secret
RADAR_LLM_API_KEY=
RADAR_LLM_BASE_URL=https://api.openai.com/v1
RADAR_LLM_MODEL=replace-with-local-or-approved-model
RADAR_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9001

WEB_PORT=3000
API_PORT=8000
CADDY_PORT=8080
POSTGRES_PORT=5432
VALKEY_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

WEB_DEV_COMMAND=pnpm --filter @amplitude/web dev --hostname 0.0.0.0
API_DEV_COMMAND=uv run uvicorn zhenfu_api.main:app --host 0.0.0.0 --port 8000 --reload
RADAR_MIGRATE_COMMAND=uv run alembic upgrade head
RADAR_INGEST_WORKER_COMMAND=uv run python -m zhenfu_api.workers.ingest
RADAR_ENRICHMENT_WORKER_COMMAND=uv run python -m zhenfu_api.workers.enrichment
