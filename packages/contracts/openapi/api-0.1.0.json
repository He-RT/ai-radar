            "minimum": 1.0,
            "title": "Public Version",
            "type": "integer"
          },
          "snapshot_schema_version": {
            "const": 1,
            "title": "Snapshot Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "snapshot_schema_version",
          "event_id",
          "public_version",
